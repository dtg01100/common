[Unit]
Description=Send daily active-system ping to Project Bluefin
Documentation=https://docs.projectbluefin.io/analytics
Wants=network-online.target
After=network-online.target
# bootc is no longer a condition: Bluefin Server is a DDI without
# /run/ostree-booted. The /home emptiness check used to be
# ConditionDirectoryNotEmpty=/home, which silently dropped every server
# install; the check now lives in the script so Server is exempt while
# Dakota/Utah live ISOs are still skipped. ProtectHome=read-only (below)
# keeps /home visible to that check.
# Opt-out files honored by the previous bluefin-countme units.
ConditionPathExists=!/etc/projectbluefin/countme/disabled
ConditionPathExists=!/etc/bluefin-countme-opt-out
ConditionPathExists=!/etc/dakota-countme/disabled
# `systemctl mask` of the previous units, the opt-out documented for them.
ConditionPathExists=!/etc/systemd/system/bluefin-countme.timer
ConditionPathExists=!/etc/systemd/system/bluefin-countme.service

[Service]
Type=simple
ExecStart=/usr/libexec/projectbluefin-countme
StateDirectory=projectbluefin-countme

# Run as root (no DynamicUser) so bootc status can query status.
# Hardened sandbox:
PrivateTmp=yes
ProtectSystem=strict
# read-only, not yes: the script reads /home to skip empty home directories
# (live ISO / unattended bootc host). `yes` would mask /home and the skip
# would fire unconditionally, silently dropping every Dakota/Utah install.
ProtectHome=read-only
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallFilter=@system-service @mount
